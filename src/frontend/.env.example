# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: Vite reads .env, NOT this file. Nothing here takes effect until copied.
# .env is already ignored by the repository-root .gitignore — never commit it.

# Base URL of the Member 2 FastAPI backend.
# Port 8000 matches APP_PORT in the repository's src/.env.example.
VITE_API_BASE_URL=http://localhost:8000

# Demo Mode.
#   unset/blank -> ON  (the default, so a fresh clone works before the backend
#                       exists — see src/services/demoMode.ts)
#   true        -> ON
#   false       -> OFF (talk only to the real backend)
#
# When ON, the UI renders the isolated golden-scenario mock data from src/mocks/
# and pins a DemoModeBanner to every screen, so it is never ambiguous whether
# you are looking at live or mock data.
#
# Demo mode is decided at startup from THIS setting, never by a request failing.
# Mock data is NEVER a fallback for a failed API call — a failed call always
# renders an ErrorState with a working Retry.
#
# Set this to false as soon as the backend is running.
VITE_DEMO_MODE=true
