# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/elevatex.db
CORS_ORIGINS=http://localhost:5173

# real  → use Member 1's deterministic intelligence engine (default)
# mock  → clearly-labelled fallback (no intelligence engine required)
INTELLIGENCE_MODE=real

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# false → contact the real backend (recommended when backend is running)
# true  → render golden-scenario mock data without contacting the backend
VITE_DEMO_MODE=false

# ── AI provider (optional AI-augmented BLUF) ──────────────────────────────────
# Controls which AI provider generates the analyst BLUF explanation.
# The deterministic intelligence engine is always authoritative for
# structured security facts (scoring, MITRE, evidence, actions).
# When unavailable, the engine falls back to its deterministic BLUF.
#
# Supported values:
#   groq          → Groq cloud API (requires GROQ_API_KEY)
#   granite       → IBM Granite via local Ollama (requires GRANITE_ENABLED=true)
#   deterministic → no external AI call; deterministic BLUF only (default)
AI_PROVIDER=deterministic

# ── Groq (cloud AI inference) ─────────────────────────────────────────────────
# Required when AI_PROVIDER=groq.
# Get a free API key at https://console.groq.com
# NEVER commit real values here.
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.1-8b-instant

# ── IBM Granite via Ollama (local AI inference) ───────────────────────────────
# Required when AI_PROVIDER=granite.
# IBM Granite is an IBM open-source foundation model running through Ollama.
# This is NOT watsonx.ai — IBM does not host or operate this inference.
#
# Setup:
#   1. Install Ollama: https://ollama.com
#   2. Pull a Granite model: ollama pull granite3-moe:3b
#   3. Set GRANITE_ENABLED=true and AI_PROVIDER=granite
#
# In Docker: Ollama is NOT accessible at localhost from inside the container.
# Set GRANITE_BASE_URL to the host machine's IP instead (see docs/setup-guide.md).
GRANITE_ENABLED=false
GRANITE_BASE_URL=http://localhost:11434/v1
GRANITE_MODEL_ID=granite3-moe:3b
